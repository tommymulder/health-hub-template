# Copy to .env.local (never commit .env.local). Production values live in Vercel env vars.
# Enter secrets yourself; never paste them into chat, a commit, or a screenshot.
# Check what is set (names and pass/fail only, never values):  npm run doctor

# ---- Required -------------------------------------------------------------------------------------------------------
MCP_SECRET=            # long random string (openssl rand -hex 32); also the connector's x-api-key value
DATABASE_URL=          # Supabase pooler URL as shown (port 6543); the code uses session mode (5432); password letters/numbers only
CRON_SECRET=           # random; Vercel sends it as "Authorization: Bearer ..." to /api/cron/daily
INGEST_KEY=            # random (openssl rand -hex 32); Health Auto Export sends it as "X-Ingest-Key". Opens ONLY /api/ingest/apple-health

# ---- Your settings (neutral defaults; set your own) ---------------------------------------------------------------------
TIMEZONE=UTC           # an IANA name such as America/New_York or Europe/London. Every "day" in every answer uses it
UNITS=kg               # kg or lb: what the tools show you (everything is stored in kg)
# HR_ZONES=92,111,129,148,166   # lower bounds of Oura heart-rate zones 1-5 in bpm, rising. This is an EXAMPLE: use your own from the Oura app
# HR_MAX=190                    # used ONLY to find a class's window (a raised-heart-rate stretch)

# ---- Sources (each turns on when its own keys exist) --------------------------------------------------------------------
# Oura: register your own app, then set both (see README):
# OURA_CLIENT_ID=
# OURA_CLIENT_SECRET=
# Hevy (optional): Hevy app > Settings > Developer (needs Hevy Pro). Without it there are no Hevy tools and no Hevy sync.
# HEVY_API_KEY=
# Apple Health arrives from the Health Auto Export app, using INGEST_KEY above. No extra setting.

# ---- Optional modules (off until listed) ------------------------------------------------------------------------------
# Comma list of: checkins, classes, genetics, events. An unknown name stops the hub with a clear error.
#   checkins  morning 1-5 rating from a phone Shortcut (needs CHECKIN_KEY)
#   classes   class-board photo -> finished Hevy workout, completion, coaching notes (needs HEVY_API_KEY)
#   genetics  stored genetic variants with notes and a lab watch-list
#   events    one-press phone events such as bathroom trips (needs CHECKIN_KEY)
# HUB_MODULES=checkins,classes
# CHECKIN_KEY=         # random (openssl rand -hex 32); the Shortcut sends it as "x-checkin-key". Opens ONLY /api/checkin, /api/checkin/today and /api/events

# ---- Labs (optional) -------------------------------------------------------------------------------------------------
# When two labs list the same result, which one wins: a comma list, most preferred first, matched as a substring of the
# performer name (the lab that ran a test over the clinic that ordered it). Empty = no preference.
# LAB_PREFERRED_PERFORMERS=
